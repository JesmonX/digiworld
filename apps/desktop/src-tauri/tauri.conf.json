{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Digiworld",
  "version": "0.2.23",
  "identifier": "io.github.jesmonx.digiworld",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Digiworld",
        "width": 1180,
        "height": 760,
        "minWidth": 1000,
        "minHeight": 680,
        "center": true,
        "decorations": false,
        "transparent": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; frame-src 'self' blob: data:; font-src 'self' asset: http://tauri.localhost https://tauri.localhost http://localhost:1420 https://*.localhost data:; img-src 'self' asset: http://tauri.localhost https://tauri.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' blob:; connect-src ipc: http://ipc.localhost https://ipc.localhost",
      "dangerousDisableAssetCspModification": [
        "script-src",
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "JesmonX",
    "shortDescription": "A lightweight, local-first modular desktop toolkit.",
    "longDescription": "Digiworld installs official signed desktop capabilities on demand.",
    "copyright": "Copyright © 2026 JesmonX",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://jesmonx.github.io/digiworld/updates/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk1NDczMzFGRjRDMTNDNUQKUldSZFBNSDBIek5IbGYxdThGb2tkVjBXeHFaaTNtMHVIb0xKbmplTzJJVTZoeWpldnpLb0JhTWMK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
