{
  "id": "io.github.jesmonx.digiworld.keyboard-heatmap",
  "version": "0.1.10",
  "uiDesignVersion": 1,
  "name": "键盘热力图",
  "description": "在 104、87、84、68 和 61 键主流配列中查看实体键位热力图，只保存每日聚合次数。",
  "icon": "keyboard",
  "author": "JesmonX",
  "license": "MIT",
  "minCoreVersion": "0.2.28",
  "ui": "ui/index.html",
  "background": "on-enable",
  "permissions": [
    {
      "id": "global-input",
      "reason": "在其他应用获得焦点时统计实体键位按下次数。"
    },
    {
      "id": "background",
      "reason": "关闭 Digiworld 窗口后继续累计键位次数。"
    },
    {
      "id": "plugin-storage",
      "reason": "在本机保存每日聚合计数和插件设置。"
    }
  ]
}
